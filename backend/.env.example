# Template Variabel Lingkungan Backend

# Kredensial MongoDB Atlas Utama
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appName>
DB_NAME=tracera
COLLECTION_NAME=raw_linkedin
PROCESSED_COLLECTION_NAME=profiles_db

# Kunci Rahasia Autentikasi Internal API (Header X-API-KEY)
INTERNAL_API_KEY=tracera-skills-intelligence-secret-key-2026 # Gunakan ini jika masih tahap development

# Konfigurasi Server & Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"] # Sesuaikan dengan kode cors anda
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development # Ubah production jika siap dirilis ke publik